<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>Hiiii!!! Here are your posts</h1>
    <!-- Input form for a new blog-->
     <form action="/submit" method="POST">
        <label for="author">Author:</label>
        <input type="text" name="author" required>
        <label for="blogTitle">Title:</label>
        <input type="text" name="blogTitle" required><br /><br />
        <label for="blogBody">Body:</label>
        <input type="text" name="blogBody" size ="99" required>
        <input type="submit" value="Submit">
     </form> 
    <!-- Renders the postsArray in Bootstrap cards -->
    <% postsArray.forEach(post => { %>
        <div class="card" style="width: 100rem;">
            <div class="card-body">
                <h2 class="card-title"><%= post.blogTitle %></h2>
                <h3 class="card-subtitle mb-2 text-body-secondary"><%= post.creatorName %></h3>
                <h4><%= post.creationTime %></h4>
                <form action="/delete" method="POST">
                    <input type="hidden" name="cardTitle" value="<%= post.blogTitle %>">
                    <button class="action-delete" id="delete">Delete</button>
                </form>
                <form action="/edit" method="POST">
                    <input type="hidden" name="cardTitle" value="<%= post.blogTitle %>">
                    <button class="action-edit" id="edit">Edit</button>
                </form>
                <%if(locals.currPost && (currPost.blogTitle === post.blogTitle)){%>
                    <form action='/editSubmit' method='POST'>
                        <label for='author'>Author:</label>
                        <input type='text' name='author' value='<%= currPost.creatorName %>'required>
                        <label for='blogTitle'>Title:</label>
                        <input type='text' name='blogTitle' value='<%= currPost.blogTitle %>'required>
                        <label for='blogTime'>Date:</label>
                        <input type='text' name='blogTime' value='<%= currPost.creationTime %>' required>
                        <label for='blogBody'>Body:</label>
                        <input type='text' name='blogBody' value='<%= currPost.blogBody %>'required><br />
                        <input type="hidden" name='oldBlogTitle' value="<%= currPost.blogTitle %>">
                        <input type='submit' value='Submit'>
                    </form>
                <%}%>
                <p class="card-text"> <%= post.blogBody %></p>
            </div>
        </div>
    <%});%>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</body>
</html>